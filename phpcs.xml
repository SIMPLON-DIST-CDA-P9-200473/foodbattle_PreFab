<?xml version="1.0"?>
<ruleset name="FoodBattle">
    <description>Norme de code du projet : PSR-12</description>

    <file>app</file>
    <exclude-pattern>app/assets/*</exclude-pattern>

    <arg name="colors"/>
    <arg value="sp"/> <!-- s : affiche le nom de chaque règle, p : barre de progression -->

    <rule ref="PSR12"/>

    <!-- Les templates mélangent HTML et PHP : une ligne HTML peut légitimement dépasser 120 caractères -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>app/templates/*</exclude-pattern>
    </rule>
</ruleset>
